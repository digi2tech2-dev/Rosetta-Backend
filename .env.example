NODE_ENV=development
PORT=8000
DATABASE=mongodb://127.0.0.1:27017/client_store_development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
ENABLE_LEGACY_BRAINTREE=false
BRAINTREE_ENVIRONMENT=Sandbox
BRAINTREE_MERCHANT_ID=replace_me
BRAINTREE_PUBLIC_KEY=replace_me
BRAINTREE_PRIVATE_KEY=replace_me
MAX_JSON_BODY_SIZE=100kb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
SHIPPING_FLAT_RATE=0
FREE_SHIPPING_MINIMUM=0
STORE_CURRENCY=USD
MAX_CART_ITEMS=50
MAX_ITEM_QUANTITY=99
UPLOAD_MAX_FILE_SIZE=2097152
